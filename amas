local Players = game:GetService("Players")
local player = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

-- GUI Setup
local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = "SimpleGui"

local frame = Instance.new("Frame", screenGui)
frame.Position = UDim2.new(0.3, 0, 0.3, 0)
frame.Size = UDim2.new(0, 300, 0, 300)
frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
frame.BorderSizePixel = 0

-- Tombol Kirim Pesan "purplelzys"
local buttonChat = Instance.new("TextButton", frame)
buttonChat.Size = UDim2.new(1, -20, 0, 40)
buttonChat.Position = UDim2.new(0, 10, 0, 10)
buttonChat.Text = "Kirim Pesan"
buttonChat.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
buttonChat.TextColor3 = Color3.new(1, 1, 1)

buttonChat.MouseButton1Click:Connect(function()
	ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("purplelzys", "All")
end)

-- Tombol Gimmick
local buttonGimmick = Instance.new("TextButton", frame)
buttonGimmick.Size = UDim2.new(1, -20, 0, 40)
buttonGimmick.Position = UDim2.new(0, 10, 0, 60)
buttonGimmick.Text = "Tombol Gimmick"
buttonGimmick.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
buttonGimmick.TextColor3 = Color3.new(1, 1, 1)

-- Scroll daftar pemain
local scrollingFrame = Instance.new("ScrollingFrame", frame)
scrollingFrame.Size = UDim2.new(1, -20, 1, -120)
scrollingFrame.Position = UDim2.new(0, 10, 0, 110)
scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
scrollingFrame.ScrollBarThickness = 6
scrollingFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

local UIListLayout = Instance.new("UIListLayout", scrollingFrame)
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder

-- Tombol pemain dengan highlight
local selectedButton = nil
local defaultColor = Color3.fromRGB(70, 70, 70)
local selectedColor = Color3.fromRGB(120, 0, 255)

local function createPlayerButton(p)
	local playerButton = Instance.new("TextButton")
	playerButton.Size = UDim2.new(1, 0, 0, 30)
	playerButton.Text = p.Name
	playerButton.BackgroundColor3 = defaultColor
	playerButton.TextColor3 = Color3.new(1, 1, 1)

	playerButton.MouseButton1Click:Connect(function()
		-- Reset warna tombol sebelumnya
		if selectedButton then
			selectedButton.BackgroundColor3 = defaultColor
		end
		selectedButton = playerButton
		playerButton.BackgroundColor3 = selectedColor

		StarterGui:SetCore("ChatMakeSystemMessage", {
			Text = "Kamu memilih: " .. p.Name,
			Color = Color3.fromRGB(200, 200, 255),
			Font = Enum.Font.SourceSansBold,
			FontSize = Enum.FontSize.Size24
		})
	end)

	playerButton.Parent = scrollingFrame
end

-- Tambahkan pemain yang ada
for _, p in ipairs(Players:GetPlayers()) do
	createPlayerButton(p)
end

-- Tambahkan pemain baru
Players.PlayerAdded:Connect(function(p)
	createPlayerButton(p)
end)