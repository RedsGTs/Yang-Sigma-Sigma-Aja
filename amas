local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Create ScreenGui
local gui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
gui.Name = "MessageGui"

-- Create Frame
local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 300, 0, 370)
frame.Position = UDim2.new(0.3, 0, 0.3, 0)
frame.BackgroundTransparency = 0.3
frame.BackgroundColor3 = Color3.new(0, 0, 0)
frame.Active = true
frame.Draggable = true

-- Rounded corners
local uicorner = Instance.new("UICorner", frame)
uicorner.CornerRadius = UDim.new(0, 12)

-- Send Message Button
local sendButton = Instance.new("TextButton", frame)
sendButton.Size = UDim2.new(0, 120, 0, 30)
sendButton.Position = UDim2.new(0, 10, 0, 10)
sendButton.Text = "Send Message"
sendButton.BackgroundColor3 = Color3.fromRGB(70, 130, 180)

-- Empty Button
local emptyButton = Instance.new("TextButton", frame)
emptyButton.Size = UDim2.new(0, 120, 0, 30)
emptyButton.Position = UDim2.new(0, 150, 0, 10)
emptyButton.Text = "Do Nothing"
emptyButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)

-- Player List ScrollingFrame
local scroll = Instance.new("ScrollingFrame", frame)
scroll.Size = UDim2.new(0, 280, 0, 310)
scroll.Position = UDim2.new(0, 10, 0, 50)
scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
scroll.BackgroundTransparency = 1
scroll.ScrollBarThickness = 6

local layout = Instance.new("UIListLayout", scroll)
layout.Padding = UDim.new(0, 5)

-- Function to refresh player list
local function updateList()
	scroll:ClearAllChildren()
	layout.Parent = scroll

	for _, player in ipairs(Players:GetPlayers()) do
		local nameButton = Instance.new("TextButton")
		nameButton.Size = UDim2.new(1, -10, 0, 30)
		nameButton.Text = player.Name
		nameButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		nameButton.TextColor3 = Color3.new(1, 1, 1)
		nameButton.BackgroundTransparency = 0.3
		nameButton.Parent = scroll

		local corner = Instance.new("UICorner", nameButton)
		corner.CornerRadius = UDim.new(0, 8)

		nameButton.MouseButton1Click:Connect(function()
			for _, btn in ipairs(scroll:GetChildren()) do
				if btn:IsA("TextButton") then
					btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
				end
			end
			nameButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
		end)
	end

	wait(0.1)
	scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
end

-- Initial list
updateList()

-- Update player list when players join or leave
Players.PlayerAdded:Connect(updateList)
Players.PlayerRemoving:Connect(updateList)

-- Send fixed message when button is clicked
sendButton.MouseButton1Click:Connect(function()
	local fixedMessage = "@purplelzys"
	game.ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents")
		:WaitForChild("SayMessageRequest"):FireServer(fixedMessage, "All")
end)